PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tictactoang
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.example

# SMTP email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FAMILY=4
SMTP_TIMEOUT_MS=8000
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM="Group7-TicTacToang" <your-email@gmail.com>
SMTP_TEST_TO=your-test-recipient@gmail.com

# Resend HTTP API (preferred on Render where outbound SMTP is blocked)
# When RESEND_API_KEY is set, it is used instead of SMTP.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=TicTacToang <onboarding@resend.dev>
# Optional: redirect every receipt to this address (use for Resend sandbox
# mode, which only delivers to the account owner's email).
RESEND_TO_OVERRIDE=your-resend-account-email@example.com

# PayPal sandbox checkout for Premium subscription
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-rest-app-client-id
PAYPAL_CLIENT_SECRET=your-paypal-rest-app-secret
PAYPAL_RETURN_URL=https://your-frontend-domain.example/subscription?paypal=success
PAYPAL_CANCEL_URL=https://your-frontend-domain.example/subscription?paypal=cancel
